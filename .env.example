# Ultra MAX Self-Host 8.1.4

# Required public origin. No trailing slash.
BASE_URL=https://your-domain.example

# Host-side port used by docker-compose. The container itself listens on 7000.
PORT=7000

# Required server-side TMDB key. Used for metadata resolution and fallbacks.
TMDB_KEY=your_tmdb_api_key

# Recommended. Enables MDBList-backed catalog rows.
MDBLIST_KEY=

# Optional OAuth integrations. Register your own applications and use callbacks
# under BASE_URL, e.g. https://your-domain.example/auth/trakt/callback
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
SIMKL_CLIENT_ID=
SIMKL_CLIENT_SECRET=
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

# Optional Google Gemini key for AI/custom recommendation features.
GOOGLE_AI_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional email recovery through Resend.
RESEND_API_KEY=
RESEND_FROM=Ultra MAX <noreply@your-domain.example>

# Optional admin/inspection secret. Leave blank to keep admin inspection disabled.
STATS_SECRET=

# Optional Nuvio collection write-back. Use your own Nuvio app credentials.
NUVIO_API_BASE=https://api.nuvio.tv
NUVIO_ANON_KEY=

# Self-host defaults. Keep the hosted production profile-store and sports
# infrastructure disabled unless you deliberately provide your own equivalents.
PROFILE_STORE_ENABLED=false
ULTRAMAX_LIVE_SPORTS_ENABLED=false
ULTRAMAX_MOTORSPORT_TORRENTS_ENABLED=false

# Docker Compose overrides this to /data inside the container.
DATA_DIR=./data
