# ── Required ──────────────────────────────────────────────

# The public URL where this addon is hosted (no trailing slash).
# Used to build OAuth redirect URIs, the addon manifest logo, share links,
# and links in recovery emails. Must match what you put in front of this
# container (see the nginx example in README.md).
BASE_URL=https://your-domain.com

# Port to run the addon on inside the container.
PORT=7000

# TMDB API key — powers movie/show metadata, search and most catalogs.
# The addon will refuse to start without this.
# Get a free key at https://www.themoviedb.org/settings/api
TMDB_KEY=your_tmdb_api_key

# ── Recommended ───────────────────────────────────────────

# MDBList API key — powers curated/trending list catalogs and the
# MDBList-backed rows in setup.html. Without it, those rows return empty.
# Get a free key at https://mdblist.com/api
MDBLIST_KEY=your_mdblist_api_key

# ── Trakt OAuth (optional — enables Trakt integration) ─────
# Register your app at https://trakt.tv/oauth/applications
# Redirect URI to register: BASE_URL/auth/trakt/callback
TRAKT_CLIENT_ID=your_trakt_client_id
TRAKT_CLIENT_SECRET=your_trakt_client_secret

# ── Simkl OAuth (optional — enables Simkl integration) ─────
# Register your app at https://simkl.com/settings/developer
# Redirect URI to register: BASE_URL/auth/simkl/callback
SIMKL_CLIENT_ID=your_simkl_client_id
SIMKL_CLIENT_SECRET=your_simkl_client_secret

# ── MyAnimeList OAuth (optional — enables MAL integration) ─
# Register your app at https://myanimelist.net/apiconfig
# App type: "other", redirect URI: BASE_URL/auth/mal/callback
# Without these set, MAL connect shows a clear "not configured" message
# instead of failing — safe to leave blank.
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=

# ── AniList OAuth (optional — enables AniList integration) ─
# Register your app at https://anilist.co/settings/developer
# Redirect URI: BASE_URL/auth/anilist/callback
# Same graceful "not configured" behaviour as MAL if left blank.
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

# ── Email recovery (optional) ─────────────────────────────
# Resend API key for token recovery / registration emails.
# Get one free at https://resend.com
# Leave blank to disable email recovery — /api/register-email and
# /api/recover-token will return a clear error instead of failing silently.
RESEND_API_KEY=your_resend_api_key
# "Display Name <address>" — must be a verified sender/domain in Resend.
RESEND_FROM=Ultra MAX <noreply@your-domain.com>

# ── AI custom rows (optional) ──────────────────────────────
# Google Gemini API key for the "describe a row in plain English" builder.
# Without it, custom rows fall back to a simple keyword parser — still
# functional, just less flexible. Get a key at https://aistudio.google.com
GOOGLE_AI_KEY=

# ── Admin (optional) ───────────────────────────────────────
# Secret required as the X-Admin-Secret header to use GET /admin/inspect/:token.
# Leave blank to keep that endpoint disabled (it 401s with no secret set).
STATS_SECRET=

# ── Bundled image library (optional) ───────────────────────
# Local directories the /assets picker and /images route read from, if you
# want to maintain your own bundled poster/logo library. Safe to leave
# unset — missing directories are skipped, not an error.
# IMAGES_DIR=./addon/images
# QUICK_IMAGES_DIR=./addon/images/quick

# ── Data directory ────────────────────────────────────────
# Where configs.json, shares.json and other persisted data live.
# In Docker this is the /data volume — don't change it in docker-compose.yml
# unless you also update the volume mount.
DATA_DIR=./data
